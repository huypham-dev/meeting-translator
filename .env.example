# ---------------------------------------------------------------------------
# ⚠️  DEVELOPMENT ONLY. Values in this file are compiled directly into the
# extension bundle at build time (Vite `import.meta.env`) and become
# READABLE BY ANYONE who unpacks/inspects the .crx or the unpacked dist/
# folder (e.g. via chrome://extensions -> "Inspect views", or by unzipping
# the package). Never publish a build made with a real API key to the
# Chrome Web Store or any shared/public location.
#
# For a production release, do NOT ship provider API keys in the extension
# at all. Instead, point the STT/translation service layer
# (src/services/stt, src/services/translation) at your own backend, which
# holds the real secrets server-side and proxies requests:
#
#   Extension -> your backend -> Deepgram / translation provider
#
# ---------------------------------------------------------------------------

# Deepgram streaming STT API key (https://console.deepgram.com/)
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Translation provider: "mymemory" (free, no key, MVP default) or "openai"
VITE_TRANSLATION_PROVIDER=mymemory

# Only required if VITE_TRANSLATION_PROVIDER=openai
VITE_OPENAI_API_KEY=
